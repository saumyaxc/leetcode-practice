#include <vector>
#include <unordered_set>

using namespace std;

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_set<int> map;

        for (int i = 0; i < nums.size(); i++) {
            if (map.count(nums[i]) > 0) {
                return true;
            }
            map.insert(nums[i]);
        }
        return false;
    }
};